# ---- Required ---------------------------------------------------------------------------------
MITRA_DOMAIN=mitra.example.com          # or <elastic-ip-with-dashes>.sslip.io, or :80 for a lab box
ACME_EMAIL=ops@example.com
POSTGRES_PASSWORD=change-me             # openssl rand -hex 24
MITRA_ADMIN_TOKEN=change-me             # openssl rand -hex 32  (operator API / CLI)
MITRA_SIGNING_SECRET=change-me          # openssl rand -hex 32  (camera upload + OTA URLs)
MITRA_MQTT_PASSWORD=change-me           # openssl rand -hex 24  (backend's own broker login)

# ---- Image build ------------------------------------------------------------------------------
# local = Piper TTS on the box (voices baked in), speech = free Google Web Speech STT.
# Add ",aws" only if you select an AWS provider below, ",wake" for server-side "Hey Smith".
MITRA_EXTRAS=local,speech

# ---- Providers (see backend/config/mitra.yaml for every option) -------------------------------
# Default = everything that costs per use runs on this machine: LLM + vision via Ollama, Piper TTS.
MITRA_STT_PROVIDER=google               # google | openai_compat | aws_transcribe | mock
MITRA_LLM_PROVIDER=openai_compat        # openai_compat (local Ollama) | bedrock | anthropic | mock
MITRA_TTS_PROVIDERS=piper_local         # comma list, first = primary, rest = fallbacks
MITRA_VISION_PROVIDER=openai_compat     # openai_compat (local Ollama) | bedrock | rekognition | none
MITRA_WAKE_PROVIDER=none                # none (push-to-talk / on-device wake) | openwakeword
MITRA_STORAGE_PROVIDER=local            # local | s3

# Local models (pulled into the ollama volume on first start; see docs/LOCAL_MODELS.md)
LLM_MODEL=qwen3:1.7b
LLM_REASONING_EFFORT=none               # turn Qwen3 thinking off; leave empty for non-thinking models
VISION_MODEL=gemma3:4b                  # multimodal; set MITRA_VISION_PROVIDER=none to save ~3.5 GB RAM
OLLAMA_MEM_LIMIT=6g

# Hosted alternatives (only needed if selected above; these bill per use)
# AWS_REGION=ap-south-1
# BEDROCK_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
# POLLY_VOICE=Kajal
# ANTHROPIC_API_KEY=
# STT_BASE_URL=https://api.groq.com/openai/v1
# STT_API_KEY=
# LLM_BASE_URL=                         # default is the in-stack Ollama
# LLM_API_KEY=

# Any value in backend/config/mitra.yaml may instead be "ssm:/mitra/<name>" to read from SSM.
MITRA_LOG_LEVEL=INFO
